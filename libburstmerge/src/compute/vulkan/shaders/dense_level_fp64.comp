#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

// ============================================================================
// dense_level_fp64 — fp64 variant of dense_level.comp.
//
// This shader is compiled ONLY when CMake option BURSTMERGE_GPU_FP64=ON is set
// (default OFF). At runtime it is dispatched only when the GPU supports
// shaderFloat64 (checked via VulkanBackend::HasFloat64()). On GPUs without
// fp64, or in default builds, the float variant (dense_level.comp) is used
// instead — identical algorithm, double accumulation in tileCostThreadFp64.
//
// ── WHERE fp64 is used ──────────────────────────────────────────────────────
//   The ONLY fp64 usage is in tileCostThreadFp64(): the per-thread partial
//   SAD/SSD cost summation. Pixel values are promoted from float to double
//   before being added to the running total. Everything else (pyramid
//   traversal, candidate search logic, shared-memory tree reduction, output
//   writes) is identical to the float variant.
//
// ── WHY fp64 improves alignment accuracy ────────────────────────────────────
//   CPU TileCost (align_common.cpp:84-99) accumulates SAD/SSD using double.
//   When the GPU uses float accumulation, rounding errors in the summation
//   cause the per-candidate cost to differ from CPU by up to ~0.1%.
//
//   In extreme exposure bracketing (EV spread > 6 stops), the SAD cost surface
//   across candidate displacements is extremely flat (large uniform regions
//   after EV normalization). A 0.1% float rounding error is enough to flip the
//   argmin — causing tiles to lock onto wrong displacements by up to 706px.
//   With float accumulation:
//     ExBkt t=64:  100% tiles diverge, max 706px off
//     ExBkt t=128: 100% tiles diverge, max 477px off
//   With double accumulation (this shader):
//     ExBkt t=64:   0.1% tiles diverge, max 12px
//     ExBkt t=128:  0% tiles diverge, 0px (bit-identical to CPU)
//
// ── v4 (2026-07-05): 64-thread-per-tile COOPERATIVE design ───────────────────
//   Previously this shader was v3-shaped: 1 thread per tile, gl_GlobalInvocationID
//   as tile coords, double cost += ... over the entire ts² pixel range. On large
//   tiles (t=96/128) the v3 fp32 variant suffered from register spill (64
//   independent float accumulators per workgroup), but the fp64 v3 (single double
//   accumulator per thread) had no such problem; v3 fp64 performance already
//   scaled linearly with tile size. The v4 port exists for structural consistency
//   with dense_level.comp v4 and to maintain identical dispatch shape
//   (tiles_x, tiles_y, 1) so that gpu_pipeline.cpp::DenseAlignGPU selects
//   shader variant without changing the dispatch parameters.
//
//   v4 structure:
//     - 64 threads per workgroup cooperate on ONE tile
//     - Each thread walks ts²/64 pixels (stride 64 in the flat pixel stream)
//     - Per-thread partial sum is a PLAIN double cost += d*d (NO Kahan)
//     - 64 partials are promoted to float and reduced via shared-memory tree
//
//   Why no Kahan is needed here (unlike fp32 v4):
//     double has a 52-bit mantissa. Worst case t=128 -> ts²=16384 px / 64
//     threads = 256 accumulations per thread. Naive double sum error is
//     bounded by 256 * 2^-52 ≈ 5.7e-14, far below any argmin flip threshold
//     (~0.1%). This matches CPU align_common.cpp::TileCost exactly (also a
//     naive double cost += ...; return float(cost)), so v4 fp64 stays
//     bit-identical to CPU on the per-tile cost when the pixel stream matches.
//
//   Dispatch shape matches fp32 v4: (tiles_x, tiles_y, 1) with local (8,8) —
//   one workgroup per tile. gpu_pipeline.cpp::DenseAlignGPU already issues
//   this shape for both shaders, so no CPU-side change is needed.
//
// ── Performance trade-off ───────────────────────────────────────────────────
//   Consumer NVIDIA GPUs have 1/64 fp64 throughput vs fp32. With v4 the fp64
//   cost is bounded by the per-thread d*d multiplies (only 1 double FMA per
//   pixel; the cross-thread reduction is float). Compared to v4 fp32 the
//   added cost is the fp64 ALU stalls on the inner loop, which ILP across 64
//   threads mostly hides. The standard alignment path (tile_refine_diag.comp)
//   is entirely float and unaffected.
//
// ── Performance: v3 vs v4 fp64 (fair comparison, RTX 3080) ──────────────────
//   LongUnder2 (16 frames, dense alignment, incl. DNG conversion ~5s):
//   | Tile | v3 fp64  | v4 fp64  | v4 gain |
//   |------+----------+----------+---------|
//   | 32   | 14.0s    | 11.2s    | 1.25×   |
//   | 64   | 15.6s    | 11.4s    | 1.37×   |
//   | 96   | 21.3s    | 11.2s    | 1.90×   |
//   | 128  | 29.6s    | 12.4s    | 2.39×   |
//   v3 scales with ts² (t=128 is 2.1× t=32), v4 is nearly flat (+11%).
//   Alignment-only (subtracting ~7s O/H): v3 at t=128 = 22.6s vs v4 = 5.4s
//   — v4 is 4.2× faster at t=128. The v3→v4 structural change DOES improve
//   fp64 performance because it distributes ts² pixel work across 64 threads
//   instead of 1 thread doing all ts² work.
// ============================================================================

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) readonly buffer Ref { float refp[]; };
layout(binding = 1) readonly buffer Cmp { float cmpp[]; };
layout(binding = 2) readonly buffer CX { int cx[]; };
layout(binding = 3) readonly buffer CY { int cy[]; };
layout(binding = 4) buffer OX { int ox[]; };
layout(binding = 5) buffer OY { int oy[]; };

const int kSearchDist = 3;  // AlignConstants::kTileSearchRadius

// Shared memory: one partial cost per (thread, candidate) for the 4-candidate
// fused batch. shape: [candidate][thread_linear] = sh_cost[cand * 64 + tid].
// 4 * 64 floats = 256 floats per workgroup = 1 KB shared memory.
// Stored as float (NOT double): per-thread partial is reduced float(cost) —
// matches CPU align_common.cpp::TileCost return type and v3 fp64 shader's
// return float(cost) semantics. Cross-thread 64-float tree reduction adds
// < 2^6 * 2^-23 ≈ 4.8e-6 relative error, far below argmin flip threshold.
shared float sh_cost[4 * 64];

int snapPeriod(int v, int p) { if (p <= 1) return v; return v >= 0 ? (v / p) * p : -((-v) / p) * p; }

// Per-thread partial SAD/SSD cost for ONE candidate, over the 1/64 disjoint
// slice of the current tile's (x0..x1, y0..y1) rectangle assigned to this
// thread. Thread linear ID = (LocalInvocationID.y * 8 + LocalInvocationID.x)
// selects the starting offset and stride 64 across the tile's flat pixel list
// (row-major, length = ts * ts_clipped). The thread covers indices
//   flat_offset = tid, flat_offset + 64, flat_offset + 128, ...
// so its inner loop walks full rows of the tile — cache-friendly and naturally
// coalesced when threads in a warp read consecutive pixels.
//
// fp64 USAGE POINT: the double accumulator below is the ONLY fp64 in this
// shader. See file header for rationale. Matches CPU TileCost
// (align_common.cpp:84-99) — same naive double cost += pattern, no Kahan.
float tileCostThreadFp64(int x0, int y0, int W, int H, int use_ssd,
                         int dx, int dy, int tid, int ts_x, int ts_y)
{
    const double OB = 65504.0LF;
    int ts = pc.i0;
    int x1 = min(W, x0 + ts);
    int y1 = min(H, y0 + ts);
    double cost = 0.0LF;
    int total_pixels = (x1 - x0) * (y1 - y0);
    int idx = tid;
    while (idx < total_pixels) {
        int local_y = idx / (x1 - x0);
        int local_x = idx - local_y * (x1 - x0);
        int px = x0 + local_x;
        int yy = y0 + local_y;
        double rv = double(refp[yy * W + px]);
        int bx = px - dx;
        int by = yy - dy;
        if (by < 0 || by >= H || bx < 0 || bx >= W) {
            cost += use_ssd != 0 ? (OB * OB) : OB;
        } else {
            double d = rv - double(cmpp[by * W + bx]);
            cost += use_ssd != 0 ? (d * d) : (d < 0.0LF ? -d : d);
        }
        idx += 64;
    }
    return float(cost);
}

// Shared-memory tree reduction of the 64-thread partial costs for one cand.
// After this returns, sh_cost[cand*64 + 0] holds the workgroup-summed cost.
void reduceOneCand(int cand)
{
    barrier();
    for (int stride = 32; stride > 0; stride >>= 1) {
        int tid = int(gl_LocalInvocationIndex);
        if (tid < stride) {
            sh_cost[cand * 64 + tid] += sh_cost[cand * 64 + tid + stride];
        }
        barrier();
    }
}

void fetchCoarse(int tx, int ty, int tiles_x, int tiles_y, int cur_tiles_x, int cur_tiles_y,
                 int level_scale, int is_coarsest, out int dvx, out int dvy)
{
    if (is_coarsest != 0) { dvx = 0; dvy = 0; return; }
    int ratio_x = max(1, tiles_x / max(1, cur_tiles_x));
    int ratio_y = max(1, tiles_y / max(1, cur_tiles_y));
    int px = min(cur_tiles_x - 1, tx / max(1, ratio_x));
    int py = min(cur_tiles_y - 1, ty / max(1, ratio_y));
    int ci = py * cur_tiles_x + px;
    dvx = cx[ci] * level_scale; dvy = cy[ci] * level_scale;
}

void main()
{
    int tx = int(gl_WorkGroupID.x);
    int ty = int(gl_WorkGroupID.y);
    int tiles_x = pc.i2; int tiles_y = pc.i3;
    if (tx >= tiles_x || ty >= tiles_y) return;
    int tile_size = pc.i0; int half_tile = pc.i1;
    int cur_tiles_x = pc.i4; int cur_tiles_y = pc.i5;
    int level_scale = pc.i6; int period = pc.i7;
    int is_coarsest = pc.i8; int use_ssd = pc.i9;
    int W = pc.w; int H = pc.h;
    int idx = ty * tiles_x + tx;
    int x0 = tx * half_tile; int y0 = ty * half_tile;
    int tid = int(gl_LocalInvocationIndex);   // 0..63 within this workgroup
    int ts_x = min(W, x0 + tile_size) - x0;
    int ts_y = min(H, y0 + tile_size) - y0;

    // ---- 1) Stage 1: 3 upsampled candidates -> seed.
    // Each candidate is evaluated by ALL 64 threads in this workgroup; their
    // per-thread partial costs are stored in sh_cost[cand*64 + tid] and a
    // tree reduction sums them. The final cost for candidate c is in
    // sh_cost[c*64 + 0].
    int cand_tx[3]; int cand_ty[3];
    cand_tx[0] = tx;     cand_ty[0] = ty;
    cand_tx[1] = clampi(tx + ((tx % 2 == 0) ? -1 : 1), 0, tiles_x - 1);  cand_ty[1] = ty;
    cand_tx[2] = tx;     cand_ty[2] = clampi(ty + ((ty % 2 == 0) ? -1 : 1), 0, tiles_y - 1);
    int up_dx[3]; int up_dy[3];
    fetchCoarse(cand_tx[0], cand_ty[0], tiles_x, tiles_y, cur_tiles_x, cur_tiles_y, level_scale, is_coarsest, up_dx[0], up_dy[0]);
    fetchCoarse(cand_tx[1], cand_ty[1], tiles_x, tiles_y, cur_tiles_x, cur_tiles_y, level_scale, is_coarsest, up_dx[1], up_dy[1]);
    fetchCoarse(cand_tx[2], cand_ty[2], tiles_x, tiles_y, cur_tiles_x, cur_tiles_y, level_scale, is_coarsest, up_dx[2], up_dy[2]);

    if (tid < 64) {
        sh_cost[0 * 64 + tid] = tileCostThreadFp64(x0, y0, W, H, use_ssd, up_dx[0], up_dy[0], tid, ts_x, ts_y);
        sh_cost[1 * 64 + tid] = tileCostThreadFp64(x0, y0, W, H, use_ssd, up_dx[1], up_dy[1], tid, ts_x, ts_y);
        sh_cost[2 * 64 + tid] = tileCostThreadFp64(x0, y0, W, H, use_ssd, up_dx[2], up_dy[2], tid, ts_x, ts_y);
        sh_cost[3 * 64 + tid] = 0.0;
    }
    reduceOneCand(0);
    reduceOneCand(1);
    reduceOneCand(2);

    int seed_x = up_dx[0]; int seed_y = up_dy[0];
    float seed_cost = sh_cost[0 * 64 + 0];
    if (sh_cost[1 * 64 + 0] < seed_cost) { seed_cost = sh_cost[1 * 64 + 0]; seed_x = up_dx[1]; seed_y = up_dy[1]; }
    if (sh_cost[2 * 64 + 0] < seed_cost) { seed_cost = sh_cost[2 * 64 + 0]; seed_x = up_dx[2]; seed_y = up_dy[2]; }

    // ---- 2) Stage 2: local search in a (2*kSearchDist+1)^2 window.
    int side = 2 * kSearchDist + 1;
    int total_search = side * side;
    int smin_x = seed_x; int smin_y = seed_y; float smin = seed_cost;
    for (int b = 0; b < total_search; ++b) {
        int oy = b / side;
        int ox = b - oy * side;
        int bdx = snapPeriod(seed_x + (ox - kSearchDist), period);
        int bdy = snapPeriod(seed_y + (oy - kSearchDist), period);
        if (tid < 64) {
            sh_cost[0 * 64 + tid] = tileCostThreadFp64(x0, y0, W, H, use_ssd, bdx, bdy, tid, ts_x, ts_y);
        }
        reduceOneCand(0);
        if (tid == 0) {
            float c = sh_cost[0 * 64 + 0];
            if (c < smin) { smin = c; smin_x = bdx; smin_y = bdy; }
        }
    }

    // ---- 3) Stage 3: write result. Only thread 0 writes.
    if (tid == 0) {
        ox[idx] = smin_x; oy[idx] = smin_y;
    }
}
